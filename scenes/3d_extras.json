    {
      "uuid": "80e28b1c-8196-493d-888a-a28018a25bad",
      "name": "About",
      "parent": "b31bba8d-f0f0-4f31-ad19-f6e9c1d54dbe",
      "Control": {
        "width": {
          "mode": "fixed",
          "value": 440.0,
