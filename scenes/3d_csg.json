    {
      "uuid": "243000ca-86d3-4506-982b-7ebae3b9d787",
      "name": "About",
      "parent": "6850a907-1942-4bf6-846f-5c5a2e25b0ab",
      "Control": {
        "width": {
          "mode": "fixed",
          "value": 460.0,
          "min": 0.0,
          "max": 3.4028235e+38,
          "weight": 1.0
        }
      },
      "ThemeOverride": {
        "override_font_size": true,
        "font_size": 13
      },
      "Label": {
        "text": "The room is one CSGShape3D group: four walls joined, an arched door, a window, a round window and a low arch cut from them - one mesh, drawn and collided with as one. The die is a box met with a ball; the stone block has a ball scooping into it, moving, so its mesh is made again each frame. The ground has a hollow cut in it. Walk in through the door with the arrows or WASD, Space to jump."
      }
    },
